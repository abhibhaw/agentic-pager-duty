# ---------------------------------------------------------------------------
# NEVER commit a filled copy of this file. It is a list of names, not values.
# ---------------------------------------------------------------------------

# --- Model -----------------------------------------------------------------
ANTHROPIC_API_KEY=
TRIAGE_MODEL=anthropic:claude-opus-5

# --- Zoho Desk -------------------------------------------------------------
# fake | rest | mcp.  Defaults to `fake`: a misconfigured deploy must fail to
# reach a customer, not reach one by accident.
ZOHO_TRANSPORT=fake
# com | eu | in | au | jp | ca | sa   (Canada is zohocloud.ca on BOTH hosts)
ZOHO_DATA_CENTRE=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DEPARTMENT_ID=
# Verified "From" address for the department. A wrong one is a 422, not a bounce.
ZOHO_FROM_EMAIL=
# Ignore tickets created before this instant (ISO-8601 UTC). Set it when
# pointing at an existing desk: the 10-minute modified-time window does NOT
# keep the backlog out, because a customer replying to an old ticket bumps its
# modified time and it arrives looking like new work. Unset, everything in the
# window is triaged.
ZOHO_MIN_CREATED_AT=
ZOHO_POLL_STATUSES=Open
ZOHO_POLL_LIMIT=50
# Only when ZOHO_TRANSPORT=mcp
ZOHO_MCP_URL=

# --- sprint-tasks ----------------------------------------------------------
GITHUB_TOKEN=
SPRINT_TASKS_REPO=devtron-labs/sprint-tasks

# --- Kill switches (default OFF — see README) ------------------------------
REPLIES_ENABLED=false
ISSUE_CREATION_ENABLED=false

# --- Platform wiring -------------------------------------------------------
LANGGRAPH_API_URL=
TRIAGE_ASSISTANT_ID=triage

# --- Slack approval for the two human gates --------------------------------
# App-level credentials. `xoxb-…` bot token, needs `chat:write` ONLY.
SLACK_BOT_TOKEN=
# The *Signing Secret* from Basic Information — NOT the bot token, and not the
# deprecated verification token. This is the entire security boundary on the
# interaction endpoint, which is a public URL. Unset means every request is
# rejected; it never means "skip the check".
SLACK_SIGNING_SECRET=
# Channel id (`C…`), not `#name`. The bot must be invited to it. Make it
# private: gate messages carry verbatim customer ticket text.
SLACK_CHANNEL_ID=
# Who may approve. A Slack *user id* (`U…`), not a display name or an email.
# Anyone who can see the message can otherwise click Approve, and approving
# gate 1 emails a paying customer. Unset means nobody can approve anything.
SLACK_APPROVER_USER_ID=
# Optional: a comma-separated list, unioned with the singular one above, for
# when there is more than one reviewer.
SLACK_APPROVER_USER_IDS=
# Optional: Slack's documented replay window, in seconds. Default 300.
SLACK_MAX_SKEW_SECONDS=300
# Optional: how many parked threads one notifier tick will look at.
SLACK_NOTIFY_LIMIT=50
# Needed by the notifier and the interaction handler to reach the deployment.
# LANGGRAPH_API_URL is set above. On a managed deployment also set:
LANGGRAPH_API_KEY=

# --- Agent Production Control Plane (autopilot) discovery -------------------
# Unset = the agent runs unobserved (logged once at startup), nothing else
# changes. See README "Control-plane discovery".
ACP_ENDPOINT=https://autopilot-new.abhibhaw.com
# Workload secret from the secret store. Must grant agent key
# `pagerduty-triage`, or registration is refused with 403. Never commit it.
ACP_CREDENTIAL=
# Optional: export run spans. Unset = no spans, runs and heartbeats still flow.
ACP_OTLP_TRACES_ENDPOINT=
# Optional: release label on heartbeats/runs. Default: the platform's git SHA.
ACP_RELEASE_DIGEST=
# Optional: stable per-replica key. Default: the hostname (the pod name).
ACP_INSTANCE_KEY=
# Never set ACP_ALLOW_INSECURE_HTTP in production.
